# --- AIRFLOW CREDENTIALS
AIRFLOW_ADMIN_USER=admin123
AIRFLOW_ADMIN_PASSWORD=admin123
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- METADATA METRICS POSTGRES
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASS=airflow_pass
AIRFLOW_DB_NAME=airflow_db
POSTGRES_PORT=5432

# SSH Target Configuration
SSH_USER=rajesh
SSH_PASS=admin123
SSH_HOST=host.docker.internal
SSH_PORT=22

# --- MLFOW DATA
DEFAULT_ARTIFACT_ROOT=/mlflow/data/mlruns
MLFLOW_DB_NAME=mlflow_metadata

# --- PORT CONFIGURATIONS
KAFKA_PORT=9092
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_UI_PORT=8081
MLFLOW_PORT=5000
AIRFLOW_WEBSERVER_PORT=8088

# --- HARDWARE MEMORY CONSTRAINTS
POSTGRES_MEM_LIMIT=600M
SPARK_MASTER_MEM_LIMIT=1000M
SPARK_WORKER_MEM_LIMIT=1500M
MLFLOW_MEM_LIMIT=600M
AIRFLOW_WEBSERVER_MEM_LIMIT=1000M
AIRFLOW_SCHEDULER_MEM_LIMIT=2500M
